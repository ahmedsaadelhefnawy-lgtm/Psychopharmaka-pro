{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Psychopharmaka Pro",
  "version": "0.7.0",
  "identifier": "com.ahmedelhefnawy.psychopharmakapro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run export",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Psychopharmaka Pro",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": []
  }
}